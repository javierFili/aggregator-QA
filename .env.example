# HTTP server (always bound to localhost by default)
HOST=127.0.0.1
PORT=3000

# Playwright
PLAYWRIGHT_HEADLESS=true

# Worker pool
DEFAULT_WORKERS=5
MAX_WORKERS=20

# Timeouts (milliseconds)
REQUEST_TIMEOUT=30000
BROWSER_TIMEOUT=45000
# Maximum time to wait for a game to render (canvas/video) after the page loads. Slow games need more.
GAME_SETTLE_TIMEOUT=25000
# After that, extra wait until the game finished loading (currency visible, or quiet network + stable screen)
GAME_READY_TIMEOUT=30000

# Where run folders (Excel, screenshots, diagnostics) are written
REPORTS_DIR=reports

# Fake seamless wallet at /wallet (answers the aggregator's balance 2051 / transfer 2052 calls with fictitious money)
FAKE_WALLET=true
FAKE_WALLET_BALANCE=100
# Per currency, optional: FAKE_WALLET_BALANCES=EUR:100,USD:100,GBP:100
FAKE_WALLET_BALANCES=
# Optional: require this Api-Key header on wallet calls (the value configured for the partner in the aggregator)
FAKE_WALLET_API_KEY=

# LOG_LEVEL: debug | info | warn | error
LOG_LEVEL=info

# --- Optional: only used by `npm run integration` (manual test against an authorized partner) ---
# QA_AGGREGATOR_URL=https://integration.playgg.uno
# QA_PARTNER_CODE=alpha-test
# QA_API_KEY=
