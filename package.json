{
  "name": "igaming-qa-runner",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "integration": "tsx src/cli/integration.ts",
    "mock:aggregator": "tsx src/dev/mockAggregatorServer.ts",
    "playwright:install": "playwright install chromium",
    "inspect:catalog": "tsx src/cli/inspectCatalog.ts",
    "tunnel": "ngrok http 127.0.0.1:3000"
  },
  "author": "",
  "license": "ISC",
  "description": "Local automated game QA runner for an iGaming aggregator",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "dotenv": "^18.0.4",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jquery": "^3.7.1",
    "playwright": "^1.63.0",
    "select2": "^4.0.13",
    "select2-bootstrap-5-theme": "^1.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.10"
  }
}
